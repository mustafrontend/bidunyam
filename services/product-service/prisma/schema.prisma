model Category {
  id          String        @id @default(uuid())
  name        String       @unique
  subCategories SubCategory[]
  products    Product[]    @relation("ProductCategory")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@map("categories")
}

model SubCategory {
  id          String     @id @default(uuid())
  name        String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[] @relation("ProductSubCategory")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@unique([name, categoryId])
  @@map("sub_categories")
}

model Brand {
  id          String     @id @default(uuid())
  name        String    @unique
  products    Product[] @relation("ProductBrand")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("brands")
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Product {
  id                   String        @id @default(uuid())
  userId               String        @default("admin-user-001")
  barcode              String        @unique
  modelCode            String
  sku                  String        @unique
  name                 String
  shortDescription     String        @default("")
  bulletPoints         String[]      @default([])
  description          String
  categoryPath         String        @default("")
  categoryAttributes   Json          @default("{}")
  price                Float
  purchasePrice        Float
  vatRate              Int           @default(20)
  originalPrice        Float
  discountPercent      Float         @default(0)
  categoryId           String?
  category             Category?   @relation("ProductCategory", fields: [categoryId], references: [id])
  subCategoryId        String?
  subCategory          SubCategory? @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  brandId              String?
  brand                Brand?      @relation("ProductBrand", fields: [brandId], references: [id])
  // Eski string alanlar opsiyonel bırakıldı (migrasyon kolaylığı için)
  categoryName         String?     @default("")
  brandName            String?     @default("")
  variants             Json          @default("[]")
  extraServices        Json          @default("[]")
  variantGroupId       String        @default("")
  variantValue         String        @default("")
  imageUrls            String[]      @default([])
  imageUrl             String
  desi                 Float         @default(0)
  preparationDays      Int           @default(1)
  shippingType         String        @default("MARKETPLACE_LOGISTICS")
  saleStatus           String        @default("ACTIVE")
  approvalStatus       String        @default("PENDING")
  marketplaceListingNo String        @default("")
  stock                Int           @default(0)
  rating               Float         @default(0)
  reviewCount          Int           @default(0)
  views                Int           @default(0)
  sales                Int           @default(0)
  isActive             Boolean       @default(true)
  // Dolap / bireysel ikinci el modeli
  condition            String        @default("SIFIR")     // SIFIR, AZ_KULLANILMIS, IKINCI_EL
  listingType          String        @default("KURUMSAL")  // KURUMSAL, BIREYSEL
  sellerName           String        @default("FUAR BOX")
  sellerRating         Float         @default(9.3)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  
  questions            Question[]
  reviews              Review[]
  campaigns            CampaignProduct[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Question {
  id           String    @id @default(uuid())
  productId    String
  category     String    @default("tümü")
  question     String
  user         String    @default("M** Ö**")
  purchased    Boolean   @default(true)
  sellerName   String    @default("FUAR BOX")
  responseRate String?   @default("15 saat içinde cevaplandı.")
  answer       String?
  status       String    @default("PENDING") // PENDING, ANSWERED
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("questions")
}

model Review {
  id           String    @id @default(uuid())
  productId    String
  rating       Int       @default(5)
  comment      String
  user         String    @default("N** Ö**")
  dateString   String    @default("26 Ağustos 2025")
  sellerName   String    @default("KOZMETİK PINARIM")
  likes        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

// ─── Shared Database Models to prevent schema dropping ───
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favorites Favorite[]

  @@index([email])
  @@map("users")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

model SellerAccount {
  id                      String      @id @default(uuid())
  email                   String      @unique
  password                String
  accountType             AccountType @default(BIREYSEL)

  // Bireysel
  fullName                String?
  tcNo                    String?
  iban                    String?

  // Tüzel
  companyName             String?
  taxNo                   String?
  taxOffice               String?
  companyIban             String?

  // Sözleşme Onayları
  acceptedKvkk            Boolean     @default(false)
  acceptedSellerAgreement Boolean     @default(false)

  // Mağaza / Bireysel storefront
  storeSlug               String?     @unique
  storeName               String?
  storeBio                String?
  storeTheme              String      @default("minimal")
  storeColor              String      @default("#7c3aed")
  storeLogo               String?
  storeBanner             String?

  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([email])
  @@map("seller_accounts")
}

enum Role {
  CUSTOMER
  ADMIN
  SELLER
}

enum AccountType {
  BIREYSEL
  TUZEL
}

// ─── Campaigns ───

model Campaign {
  id              String   @id @default(uuid())
  title           String
  description     String?
  imageUrl        String?
  discountType    String   @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  discountValue   Float    @default(0) // Minimum indirim kuralı veya sabit indirim değeri
  startDate       DateTime
  endDate         DateTime
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, ENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  products        CampaignProduct[]

  @@map("campaigns")
}

model CampaignProduct {
  id              String   @id @default(uuid())
  campaignId      String
  productId       String
  sellerId        String
  campaignPrice   Float    // Kampanyaya katılırkenki indirimli fiyat
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([sellerId])
  @@map("campaign_products")
}


model XmlFeed {
  id              String   @id @default(uuid())
  userId          String   @default("admin-user-001")
  name            String
  url             String
  isActive        Boolean  @default(true)
  syncInterval    Int      @default(60)
  lastSyncAt      DateTime?
  lastSyncStatus  String?
  fieldMapping    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("xml_feeds")
}

model CategoryFilterTemplate {
  id           String   @id @default(uuid())
  categoryName String   @unique
  filters      Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("category_filter_templates")
}
